# Copia questo file in ".env" (stessa cartella) e compila i valori.
# Il file .env NON va mai messo su Git né in una cartella raggiungibile dal web.

# "sviluppo" oppure "produzione" (in produzione il cookie di sessione viaggia solo su HTTPS)
APP_ENV=sviluppo
# Indirizzo pubblico di questo backend (senza barra finale): finisce nei link delle email
APP_URL=http://localhost:8090
# Indirizzo del front end a cui Stripe riporta l'utente dopo il pagamento
FRONTEND_URL=http://localhost:8080/sito
# Front end wolfpress-php (senza barra finale). Se compilati, i link delle email e il
# ritorno da Stripe portano al portale e al sito invece che alle API.
PORTALE_URL=http://localhost:8080/portale
SITO_URL=http://localhost:8080/sito
# Origini (separate da virgola) autorizzate a chiamare le API dal browser
CORS_ORIGINI=http://localhost:8080

# --- Database ---
DB_HOST=127.0.0.1
DB_PORTA=3306
DB_NOME=wolfpress
DB_UTENTE=wolfpress
DB_PASSWORD=

# --- Chiavi segrete: generarle con  php bin/genera-chiavi.php ---
# Se CHIAVE_CIFRATURA o CHIAVE_INDICE vanno perse, le email salvate non sono più leggibili.
CHIAVE_CIFRATURA=
CHIAVE_INDICE=
PEPE_PASSWORD=

# --- Email automatiche ---
# smtp = server SMTP (consigliato) | mail = funzione mail() di PHP | log = scrive in storage/email.log (solo sviluppo)
MAIL_DRIVER=log
MAIL_MITTENTE=no-reply@wolfpress.example
MAIL_NOME_MITTENTE=WolfPress
SMTP_HOST=
SMTP_PORTA=587
# tls = STARTTLS (porta 587) | ssl = TLS diretto (porta 465)
SMTP_SICUREZZA=tls
SMTP_UTENTE=
SMTP_PASSWORD=

# --- Stripe (https://dashboard.stripe.com/apikeys) ---
# Chiave segreta: sk_test_... in prova, sk_live_... in produzione
STRIPE_CHIAVE_SEGRETA=
# Segreto del webhook (whsec_...), dalla pagina Webhook della dashboard Stripe
STRIPE_SEGRETO_WEBHOOK=
DONAZIONE_MIN_CENT=100
DONAZIONE_MAX_CENT=500000
